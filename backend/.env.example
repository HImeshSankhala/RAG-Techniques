# Template only — copy to backend/.env and fill in there.
# This file IS committed. NEVER put a real key in it. backend/.env is gitignored.

# Which backend answers queries: "ollama" (local, free) or "anthropic" (paid).
LLM_BACKEND=ollama

# --- Local backend (default) ---
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
OLLAMA_HOST=http://localhost:11434

# --- Anthropic backend (optional, opt-in per request) ---
# Haiku only — config rejects any other model at startup.
# Set a Console spend limit and keep auto-reload OFF.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_SESSION_CALLS=50

# Origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:3000
