# Copy to backend/.env and fill in. NEVER commit .env.

# Required for answer generation. Retrieval works without it; POST /api/run
# returns 503 with setup instructions until it is set.
ANTHROPIC_API_KEY=

# Optional overrides — defaults live in core/config.py.
# ANSWER_MODEL=claude-opus-5
# ANSWER_EFFORT=low
# TOP_K=4

# Origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:3000
